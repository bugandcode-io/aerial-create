{
  "name": "aerial-create",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "api:dev": "node --env-file=.env --import tsx --watch server/index.ts",
    "api:start": "node --env-file=.env --import tsx server/index.ts",
    "db:migrate": "node --env-file=.env --import tsx server/migrate.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "node --test tests/*.test.mjs && node --import tsx --test server/tests/*.test.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie": "^1.1.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "konva": "^10.3.3",
    "mysql2": "^3.24.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.2.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
